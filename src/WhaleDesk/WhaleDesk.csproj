<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>WhaleDesk</AssemblyName>
    <RootNamespace>WhaleDesk</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>WhaleDesk.App</StartupObject>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Company>WhaleDesk</Company>
    <Product>小鲸娘桌面伴侣 (WhaleDesk)</Product>
    <Description>Desktop companion pet with DSH integration, system monitoring and cleanup helpers.</Description>
    <Copyright>WhaleDesk contributors. Sprite art: original author @linxin666 (not redistributed alone).</Copyright>
    <Version>0.25.1</Version>
    <FileVersion>0.25.1.0</FileVersion>
    <ApplicationIcon>..\..\assets\whaledesk.ico</ApplicationIcon>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- framework-dependent: the machine already has Microsoft.WindowsDesktop.App 9.0.19 -->
    <SelfContained>false</SelfContained>
    <DebugType>none</DebugType>
    <!-- InvariantGlobalization MUST stay false: with it on, WPF text input goes through the
         IME path and reports every keystroke as Key.ImeProcessed, so the search palette never
         received typed characters and arrow keys did nothing (reported 2026-10-24, reproduced
         with a Notepad-foreground harness: "key=ImeProcessed text=''"). -->
    <!-- WFO0003: the WinForms analyser wants DPI configured through
         ApplicationHighDpiMode because UseWindowsForms is on. This app never calls
         WinForms Application.Run; WPF reads the manifest's PerMonitorV2 declaration,
         which the 125% DPI measurements confirm works. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- UseWindowsForms injects System.Drawing / System.Windows.Forms as global
         usings, which then collide with WPF's Brush/Image/Point/MouseEventArgs.
         The tray file imports them explicitly instead. -->
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

</Project>
