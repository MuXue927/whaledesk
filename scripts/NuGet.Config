<?xml version="1.0" encoding="utf-8"?>
<!--
  Minimal restore config used by build-dist*.cmd.
  Two reasons for shipping our own file instead of the user's %APPDATA%\NuGet\NuGet.Config:
    1. a locked-down environment can make that path unreadable (restore then fails before it
       even tries the network),
    2. deterministic sources: only nuget.org, no machine-specific feeds.
  The self-contained build still needs internet the first time (win-x64 runtime packs).
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
